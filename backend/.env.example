WILDLIFE_DETECTOR_BACKEND=auto
WILDLIFE_CLASSIFIER_BACKEND=bioclip
WILDLIFE_INFERENCE_DEVICE=cpu
WILDLIFE_MODELS_DIR=models
WILDLIFE_STORAGE_DIR=storage
WILDLIFE_YOLO_CONFIG_DIR=storage/ultralytics

# Optional explicit model locations.
# WILDLIFE_DETECTOR_MODEL_PATH=models/megadetector/md_v6.pt
# WILDLIFE_CLASSIFIER_MODEL_PATH=models/species-classifier/amazon_v2.ckpt
# Local fine-tuned classifier baseline:
# WILDLIFE_CLASSIFIER_BACKEND=transformers
WILDLIFE_CLASSIFIER_MODEL_PATH=models/species-classifier-local-v14-manual
# BioCLIP 2 zero-shot classifier. The first launch downloads about 1.7 GB of
# weights into the Hugging Face cache; set the device to cuda when available.
WILDLIFE_BIOCLIP_MODEL_NAME=hf-hub:imageomics/bioclip-2
WILDLIFE_BIOCLIP_HF_ENDPOINT=https://hf-mirror.com
WILDLIFE_BIOCLIP_MIN_CONFIDENCE=0.60
WILDLIFE_BIOCLIP_MIN_MARGIN=0.08
WILDLIFE_BIOCLIP_EXPAND_CATALOG=true
WILDLIFE_BIOCLIP_TARGET_LABELS=中华斑羚|Naemorhedus griseus,中华穿山甲|Manis pentadactyla,大灵猫|Viverra zibetha,梅花鹿|Cervus nippon,水鹿|Rusa unicolor,猕猴|Macaca mulatta,白头叶猴|Trachypithecus leucocephalus,豹猫|Prionailurus bengalensis,赤狐|Vulpes vulpes,野猪|Sus scrofa,黄喉貂|Martes flavigula,黑熊|Ursus thibetanus
#
# Optional Qwen/DashScope vision classifier. Keep the key only in backend/.env.
# Switch WILDLIFE_CLASSIFIER_BACKEND to qwen to use this instead of the local
# transformers classifier.
# WILDLIFE_CLASSIFIER_BACKEND=qwen
WILDLIFE_MULTIMODAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WILDLIFE_MULTIMODAL_API_KEY=
WILDLIFE_MULTIMODAL_MODEL=qwen-vl-plus
WILDLIFE_MULTIMODAL_TIMEOUT_SECONDS=45
WILDLIFE_MULTIMODAL_TARGET_LABELS=中华斑羚,中华穿山甲,大灵猫,梅花鹿,水鹿,猕猴,白头叶猴,豹猫,赤狐,野猪,黄喉貂,黑熊,未知动物
#
# Reference retrieval is an internal evidence source. Prefer the transformers
# embedding backend when the local v13 model is present; fall back to histogram
# only for lightweight demos.
WILDLIFE_REFERENCE_RETRIEVAL_BACKEND=transformers
WILDLIFE_REFERENCE_EMBEDDING_MODEL_PATH=models/species-classifier-local-v14-manual
WILDLIFE_WEAK_REFERENCE_MANIFEST_PATH=reference_species/pdf_guangxi_species_images_v2/weak_reference_manifest.csv
WILDLIFE_WEAK_REFERENCE_MAX_CONFIDENCE=0.46
WILDLIFE_WEAK_REFERENCE_CONFIDENCE_BOOST=0.08
WILDLIFE_WEAK_REFERENCE_OVERRIDE_MARGIN=0.06

WILDLIFE_DEFAULT_CONFIDENCE_THRESHOLD=0.35
WILDLIFE_DEFAULT_FRAME_INTERVAL_SECONDS=1.0
WILDLIFE_MAX_VIDEO_FRAMES=90
WILDLIFE_SPECIES_CONFIDENCE_THRESHOLD=0.65
WILDLIFE_SPECIES_READY_THRESHOLD=0.70
WILDLIFE_SPECIES_CANDIDATE_THRESHOLD=0.45
WILDLIFE_RETRIEVAL_DISPLAY_OVERRIDE_THRESHOLD=0.35
WILDLIFE_RETRIEVAL_DISPLAY_OVERRIDE_CLASSIFIER_MAX_CONFIDENCE=0.65

# Optional ecology assistant LLM enhancement. Leave API key empty to use the
# built-in local knowledge assistant only.
WILDLIFE_LLM_API_KEY=
WILDLIFE_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
WILDLIFE_LLM_MODEL=gpt-4o-mini
WILDLIFE_LLM_TIMEOUT_SECONDS=30

# Dual-client platform persistence, authentication and async processing.
# Use PostgreSQL/Redis/MinIO values from docker-compose.yml in production.
WILDLIFE_DATABASE_URL=sqlite:///runtime/platform.db
WILDLIFE_JWT_SECRET=replace-with-a-long-random-secret
WILDLIFE_ACCESS_TOKEN_MINUTES=30
WILDLIFE_REFRESH_TOKEN_DAYS=7
WILDLIFE_COOKIE_SECURE=false
WILDLIFE_BOOTSTRAP_ADMIN_USERNAME=admin
WILDLIFE_BOOTSTRAP_ADMIN_PASSWORD=admin123
WILDLIFE_TASK_BACKEND=local
WILDLIFE_REDIS_URL=redis://localhost:6379/0
WILDLIFE_OBJECT_STORAGE_ENABLED=false
WILDLIFE_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
WILDLIFE_OBJECT_STORAGE_BUCKET=wildlife-media
WILDLIFE_OBJECT_STORAGE_ACCESS_KEY=wildlife
WILDLIFE_OBJECT_STORAGE_SECRET_KEY=wildlife-secret
WILDLIFE_PLANT_RECOGNITION_ENABLED=false
